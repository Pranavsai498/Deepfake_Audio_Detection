*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb

# Gradio & Web Demo Artifacts
flagged/
gradio_cached_examples/
.gradio/

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.directory

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs & Temporary Files
*.log
scratch/
